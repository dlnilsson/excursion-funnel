# Copy to /etc/excursion-funnel/hub.env (chmod 600, owned by the service user).

# EF gateway address other machines' `ef serve` will report to. Since TLS to the
# hub is required by default, this is meant to sit behind a TLS terminator —
# bind it to loopback only and expose it with, e.g.:
#   sudo tailscale serve --bg --tls-terminated-tcp=9494 tcp://127.0.0.1:9494
# Clients then set EF_HUB_ADDR to your MagicDNS name (e.g.
# homebox.tail588fb8.ts.net:9494), not this loopback address or a raw IP —
# the TLS cert is issued for that hostname, so clients must dial it by name.
EF_HUB_ADDR=127.0.0.1:9494

# Internal Quack listener. It must remain loopback-only.
EF_HUB_QUACK_ADDR=127.0.0.1:9495

# OpenSSH authorized_keys file containing ordinary ssh-ed25519 public keys.
EF_HUB_AUTHORIZED_KEYS=/etc/excursion-funnel/authorized_keys

# Long, random hub-only token. Do not configure it on clients.
EF_HUB_TOKEN=replace-with-a-long-random-token

# Dashboard listen address. Same idea as above — keep it on loopback and
# expose it via `tailscale serve --bg --https=443 http://127.0.0.1:8788`.
EF_ADDR=127.0.0.1:8788

# DuckDB ledger path. StateDirectory=excursion-funnel in the unit file
# creates /var/lib/excursion-funnel for you before the service starts.
EF_DB=/var/lib/excursion-funnel/usage.duckdb
